// ═══════════════════════════════════════════════════════════════
//  NDAU DIGITAL — REGRAS DE SEGURANÇA FIRESTORE
//  Cole em: Firebase Console → Firestore → Rules
// ═══════════════════════════════════════════════════════════════

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Funções Auxiliares ──────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return request.auth.uid == uid;
    }
    function isAdmin() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // ── Utilizadores ────────────────────────────────────────────
    match /users/{uid} {
      allow read:   if isAuth();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // ── Traduções ───────────────────────────────────────────────
    match /translations/{id} {
      allow read:   if isAuth();
      allow create: if isAuth() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.sourceText.size() > 0 &&
                       request.resource.data.ndauText.size()   > 0;
      // Só pode actualizar status (validação), não o conteúdo
      allow update: if isAuth() && (
                       isAdmin() ||
                       (request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['validatedBy','rejectedBy','status','earnedMT']))
                    );
      allow delete: if isAdmin();
    }

    // ── Gravações ───────────────────────────────────────────────
    match /recordings/{id} {
      allow read:   if isAuth();
      allow create: if isAuth() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.word.size() > 0;
      allow update: if isAuth() && (
                       isAdmin() ||
                       (request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['validatedBy','rejectedBy','status','earnedMT']))
                    );
      allow delete: if isAdmin();
    }

    // ── Levantamentos ───────────────────────────────────────────
    match /withdrawals/{id} {
      allow read:   if isAuth() && (
                       resource.data.userId == request.auth.uid || isAdmin()
                    );
      allow create: if isAuth() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.amount > 0;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Dicionário Ndau ─────────────────────────────────────────
    match /ndau_dictionary/{id} {
      allow read:   if true;   // público para leitura
      allow create: if isAuth();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Estatísticas Globais ────────────────────────────────────
    match /platform_stats/{id} {
      allow read:   if true;   // público
      allow write:  if isAdmin();
    }
  }
}
